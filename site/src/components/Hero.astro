---
import { Image } from 'astro:assets';
// Transparent cutout generated from the original portrait via Apple Vision
// subject segmentation (scripts/ — original stays in the source folders).
import portrait from '../assets/photos/mary-ann-portrait-cutout.png';
---

<section class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 md:grid-cols-[1.2fr_1fr] md:py-24">
    <div>
      <p class="section-label hero-up" style="--d: 0s">Children's Book Author · Mindanao, Philippines</p>
      <h1 class="font-display hero-up mt-4 text-4xl leading-tight md:text-6xl" style="--d: 0.08s">Mary Ann Ordinario</h1>
      <p class="font-display hero-up mt-3 text-xl italic text-terracotta-dark md:text-2xl" style="--d: 0.16s">
        Award-winning author of over 75 children's books
      </p>
      <p class="hero-up mt-6 max-w-xl leading-relaxed text-ink-soft" style="--d: 0.24s">
        Stories that inspire children to appreciate culture, peace, diversity, environmental
        conservation, and Filipino values — read in many languages around the world.
      </p>
      <!-- Desktop CTAs. On mobile the hero reads title → portrait → centered
           CTAs instead, so this pair is duplicated below the image — keep both
           instances in sync. -->
      <div class="hero-up mt-8 hidden flex-wrap gap-4 md:flex" style="--d: 0.32s">
        <a href="/books" class="rounded-full bg-terracotta-dark px-7 py-3 font-semibold text-cream transition hover:bg-terracotta">Explore Books</a>
        <a href="#contact" class="rounded-full border border-ink/20 px-7 py-3 font-semibold transition hover:border-terracotta hover:text-terracotta">Get in Touch</a>
      </div>
    </div>
    <div class="relative mx-auto w-64 md:w-full md:max-w-sm">
      <!-- Scalloped storybook cloud, like cut construction paper -->
      <svg class="hero-cloud absolute -inset-x-6 bottom-0 top-14" viewBox="0 0 200 200" preserveAspectRatio="none" aria-hidden="true">
        <path
          class="fill-sand"
          d="M182,100 A23,23 0 0 1 171,141 A23,23 0 0 1 141,171 A23,23 0 0 1 100,182 A23,23 0 0 1 59,171 A23,23 0 0 1 29,141 A23,23 0 0 1 18,100 A23,23 0 0 1 29,59 A23,23 0 0 1 59,29 A23,23 0 0 1 100,18 A23,23 0 0 1 141,29 A23,23 0 0 1 171,59 Z"
        />
      </svg>
      <!-- Dotted story-trail arcing overhead, like a journey line in a picture book -->
      <svg class="hero-trail absolute -inset-3 text-terracotta/50" viewBox="0 0 200 200" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <path d="M14 146 A 92 92 0 1 1 186 146" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="0.2 7" />
      </svg>
      <!-- The LCP image: eager + high priority, unlike every book cover below
           the fold, which keeps Astro's lazy default. The wrapper carries the
           sticker-press entrance so the animation never fights the Image class. -->
      <div class="hero-portrait relative">
        <Image src={portrait} alt="Portrait of Mary Ann Ordinario" widths={[320, 480, 640]} sizes="(min-width: 768px) 24rem, 16rem" class="sticker" loading="eager" fetchpriority="high" />
      </div>
      <!-- Tiny drawings from her own award-winning books, sketching themselves
           in after the portrait lands -->
      <!-- A Whale in Prison -->
      <svg class="hero-draw absolute -left-10 bottom-6 w-20 -rotate-6 text-terracotta" style="--d: 0.7s" viewBox="0 0 44 22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path pathLength="1" d="M4 16 C 3 8, 11 3, 19 4 C 27 5, 31 10, 30 15 C 24 19, 10 20, 4 16 Z" />
        <path pathLength="1" d="M30 12 C 33 10, 35 7, 35 4 C 37 8, 40 10, 43 10 C 40 13, 35 14, 31 15" />
        <path pathLength="1" d="M15 13 C 17 15, 20 15, 22 13" />
        <circle cx="10" cy="9" r="1" fill="currentColor" stroke="none" />
      </svg>
      <!-- The Pencil Who Would Not Write -->
      <svg class="hero-draw absolute -right-6 top-10 w-10 rotate-12 text-terracotta" style="--d: 0.9s" viewBox="0 0 28 36" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path pathLength="1" d="M20 4 L 26 10 L 12 28 L 5 31 L 6 24 Z" />
        <path pathLength="1" d="M17 8 L 23 13" />
      </svg>
      <!-- Gold stars, twinkling gently once the page settles -->
      <svg class="hero-star absolute -left-3 top-3 w-8 text-terracotta" style="--d: 0s" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 1 C 13 8, 16 11, 23 12 C 16 13, 13 16, 12 23 C 11 16, 8 13, 1 12 C 8 11, 11 8, 12 1 Z" />
      </svg>
      <svg class="hero-star absolute right-4 -top-1 w-4 text-terracotta/60" style="--d: 1.6s" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 1 C 13 8, 16 11, 23 12 C 16 13, 13 16, 12 23 C 11 16, 8 13, 1 12 C 8 11, 11 8, 12 1 Z" />
      </svg>
    </div>
    <!-- Mobile CTAs: centered under the portrait so the hero closes on the
         action. Duplicate of the desktop pair above — keep in sync. The extra
         top margin keeps the pills clear of the portrait's cloud backdrop. -->
    <div class="hero-up mt-4 flex flex-wrap justify-center gap-4 md:hidden" style="--d: 0.4s">
      <a href="/books" class="rounded-full bg-terracotta-dark px-7 py-3 font-semibold text-cream transition hover:bg-terracotta">Explore Books</a>
      <a href="#contact" class="rounded-full border border-ink/20 px-7 py-3 font-semibold transition hover:border-terracotta hover:text-terracotta">Get in Touch</a>
    </div>
  </div>
</section>

<style>
  /* One orchestrated entrance: text steps in, the portrait presses down like a
     sticker, then the doodles sketch themselves. Pure CSS, one-shot, and
     entirely absent for reduced-motion users (base styles stay visible). */
  @media (prefers-reduced-motion: no-preference) {
    .hero-up {
      opacity: 0;
      transform: translateY(14px);
      animation: hero-up 0.55s ease-out forwards;
      animation-delay: var(--d, 0s);
    }
    @keyframes hero-up {
      to {
        opacity: 1;
        transform: none;
      }
    }

    .hero-cloud {
      opacity: 0;
      animation: hero-fade 0.7s ease-out 0.15s forwards;
    }
    .hero-trail {
      opacity: 0;
      animation: hero-fade 0.9s ease-out 0.55s forwards;
    }
    @keyframes hero-fade {
      to {
        opacity: 1;
      }
    }

    .hero-portrait {
      opacity: 0;
      transform: scale(0.9);
      animation: hero-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s forwards;
    }
    @keyframes hero-pop {
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    /* pathLength="1" on each path lets one dasharray rule draw any shape */
    .hero-draw path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: hero-draw 0.9s ease forwards;
      animation-delay: var(--d, 0.7s);
    }
    .hero-draw circle {
      opacity: 0;
      animation: hero-fade 0.4s ease forwards;
      animation-delay: calc(var(--d, 0.7s) + 0.7s);
    }
    @keyframes hero-draw {
      to {
        stroke-dashoffset: 0;
      }
    }

    .hero-star {
      transform-origin: center;
      animation: hero-twinkle 3.2s ease-in-out infinite;
      animation-delay: var(--d, 0s);
    }
    @keyframes hero-twinkle {
      0%,
      100% {
        opacity: 0.6;
        transform: scale(0.92);
      }
      50% {
        opacity: 1;
        transform: scale(1.08);
      }
    }
  }
</style>
