---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getCover } from '../lib/covers';
import BookCard from './BookCard.astro';

const award = (await getCollection('books')).filter((b) => b.data.category === 'award-winning');
// HARD DEPENDENCY on the 'i-love-tnalak' id in src/data/books.json. This section
// promotes that specific book as the 2026 highlight; renaming or removing that
// entry's id will throw at build time (the non-null assertion below).
const tnalak = award.find((b) => b.id === 'i-love-tnalak')!;
const rest = award.filter((b) => b.id !== 'i-love-tnalak');
const tnalakCover = getCover(tnalak.data.cover);
---

<section id="awards" class="bg-ivory py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="reveal text-center">
      <p class="section-label">Recognition</p>
      <h2 class="font-display mt-3 text-3xl md:text-4xl">Award-Winning Books</h2>
    </div>

    <div class="reveal relative mt-12 grid items-center gap-10 rounded-2xl bg-cream p-8 ring-1 ring-sand md:grid-cols-[230px_1fr] md:p-10">
      <!-- Gold star pinned to the card corner, like a prize sticker -->
      <svg class="absolute -left-4 -top-4 w-10 rotate-[-8deg] text-terracotta" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 1 C 13 8, 16 11, 23 12 C 16 13, 13 16, 12 23 C 11 16, 8 13, 1 12 C 8 11, 11 8, 12 1 Z" />
      </svg>
      {tnalakCover && (
        <div class="mx-auto w-44 -rotate-2 transition duration-300 hover:rotate-0 md:w-full">
          <Image src={tnalakCover} alt={`Cover of ${tnalak.data.title}`} widths={[230, 460]} sizes="230px" class="sticker rounded-lg" />
        </div>
      )}
      <div>
        <!-- Hand-drawn laurel flanking the highlight label -->
        <p class="flex items-center gap-3">
          <svg class="w-6 text-terracotta-dark" viewBox="0 0 24 28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 3 C 10 7, 6 15, 8 25" />
            <path d="M8 25 C 5 23, 3 20, 3 17 C 6 18, 8 20, 8 25 Z M7 16 C 4 14, 3 11, 4 8 C 6 10, 8 12, 7 16 Z M9 9 C 8 6, 9 3, 12 1 C 12 4, 11 7, 9 9 Z" />
          </svg>
          <span class="section-label">2026 Highlight</span>
          <svg class="w-6 -scale-x-100 text-terracotta-dark" viewBox="0 0 24 28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 3 C 10 7, 6 15, 8 25" />
            <path d="M8 25 C 5 23, 3 20, 3 17 C 6 18, 8 20, 8 25 Z M7 16 C 4 14, 3 11, 4 8 C 6 10, 8 12, 7 16 Z M9 9 C 8 6, 9 3, 12 1 C 12 4, 11 7, 9 9 Z" />
          </svg>
        </p>
        <h3 class="font-display mt-2 text-2xl md:text-3xl">{tnalak.data.title}</h3>
        {/*
          This paragraph mirrors the `awards` array of the 'i-love-tnalak' entry
          in src/data/books.json. If those award strings change, update this copy
          alongside them — it is hand-written prose, not derived from the data.
        */}
        <p class="mt-4 leading-relaxed text-ink-soft">
          Selected by UNESCO and the International Board on Books for Young People (IBBY) as a
          Remarkable Book for Young Readers in Indigenous and Endangered Languages — launched at
          the 40th IBBY World Congress in Ottawa, Canada, and exhibited in the official Congress
          program.
        </p>
      </div>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
      {rest.map((b, i) => (
        <div
          class:list={['reveal', i % 2 === 0 ? '-rotate-[0.8deg]' : 'rotate-[0.8deg]']}
          style={`transition-delay: ${(i % 4) * 70}ms`}
        >
          <BookCard
            title={b.data.title}
            cover={getCover(b.data.cover)}
            category={b.data.category}
            awards={b.data.awards}
            translations={b.data.translations}
          />
        </div>
      ))}
    </div>
  </div>
</section>
