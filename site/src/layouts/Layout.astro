---
import '../styles/global.css';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/inter';
import PaperEdge from '../components/PaperEdge.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const nav = [
  { href: '/#about', label: 'About' },
  { href: '/books', label: 'Books' },
  { href: '/#awards', label: 'Awards' },
  { href: '/#news', label: 'News' },
  { href: '/#contact', label: 'Contact' },
];

// Client-supplied channels (Updates.docx, Aug 2026). The marks are drawn as
// stroked line art rather than dropped in as brand glyphs so they sit in the
// same hand-drawn family as the footer's stars and whale.
const socials = [
  {
    label: 'Facebook — ABC EDC Children\'s Books',
    href: 'https://www.facebook.com/ABCEDCChildrensBooks',
    icon: `<svg class="w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
      <path d="M15.5 7.5 H 14 C 12.6 7.5, 12 8.4, 12 9.6 V 12 M10 12 H 15 M12 12 V 21.5" />
    </svg>`,
  },
  {
    label: 'Instagram — @abcchildrensbook',
    href: 'https://www.instagram.com/abcchildrensbook/',
    icon: `<svg class="w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
      <circle cx="12" cy="12" r="4.4" />
      <circle cx="17.4" cy="6.6" r="1.05" fill="currentColor" stroke="none" />
    </svg>`,
  },
  {
    label: 'Shop the books on Shopee',
    href: 'https://s.shopee.ph/4AyZOdfJJp',
    icon: `<svg class="w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 8 H 20 L 18.7 20.2 C 18.6 21.2, 17.8 21.5, 17 21.5 H 7 C 6.2 21.5, 5.4 21.2, 5.3 20.2 Z" />
      <path d="M8.5 8 V 6 C 8.5 3.8, 10.1 2.5, 12 2.5 C 13.9 2.5, 15.5 3.8, 15.5 6 V 8" />
    </svg>`,
  },
];
const ogImage = new URL('/images/mary-ann-portrait.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- .reveal starts at opacity:0 and is only revealed by the IntersectionObserver.
         Without JS that hid everything below the stats band, so opt out entirely.
         !important is required: Astro injects the stylesheet link *after* this
         block, so equal-specificity rules in global.css would otherwise win. -->
    <noscript><style>.reveal{opacity:1!important;transform:none!important}</style></noscript>
  </head>
  <body>
    <header class="sticky top-0 z-40 border-b border-sand bg-cream/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/" class="font-display text-xl tracking-wide">Mary Ann Ordinario</a>
        <nav class="hidden gap-8 text-sm md:flex" aria-label="Main">
          {nav.map((l) => (
            <a href={l.href} class="text-ink-soft transition hover:text-terracotta">{l.label}</a>
          ))}
        </nav>
        <button
          id="menu-btn"
          class="md:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
      <nav id="mobile-menu" class="hidden flex-col gap-4 border-t border-sand px-5 py-4 md:hidden" aria-label="Mobile">
        {nav.map((l) => (
          <a href={l.href} class="text-ink-soft">{l.label}</a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer id="contact" class="relative bg-ink text-cream">
      <PaperEdge class="absolute inset-x-0 bottom-full z-10 h-4 fill-ink" />
      <!-- Night-sky doodles: the last page of the storybook -->
      <svg class="footer-star absolute left-[8%] top-12 w-6 text-cream/25" style="--d: 0s" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 1 C 13 8, 16 11, 23 12 C 16 13, 13 16, 12 23 C 11 16, 8 13, 1 12 C 8 11, 11 8, 12 1 Z" />
      </svg>
      <svg class="footer-star absolute right-[10%] top-20 w-4 text-cream/20" style="--d: 2.1s" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 1 C 13 8, 16 11, 23 12 C 16 13, 13 16, 12 23 C 11 16, 8 13, 1 12 C 8 11, 11 8, 12 1 Z" />
      </svg>
      <svg class="footer-whale absolute left-[14%] bottom-14 w-16 rotate-6 text-cream/20" viewBox="0 0 44 22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 16 C 3 8, 11 3, 19 4 C 27 5, 31 10, 30 15 C 24 19, 10 20, 4 16 Z" />
        <path d="M30 12 C 33 10, 35 7, 35 4 C 37 8, 40 10, 43 10 C 40 13, 35 14, 31 15" />
        <circle cx="10" cy="9" r="1" fill="currentColor" stroke="none" />
      </svg>
      <svg class="absolute right-[12%] bottom-16 w-8 -rotate-12 text-cream/20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17 2 C 11 4, 8 9, 9 14 C 10 19, 14 22, 19 22 C 13 24, 6 21, 4 15 C 2 9, 7 3, 17 2 Z" />
      </svg>
      <div class="relative mx-auto max-w-6xl px-5 py-16 text-center">
        <p class="section-label">Get In Touch</p>
        <h2 class="font-display mt-3 text-3xl md:text-4xl">Let's tell a story together</h2>
        <p class="mx-auto mt-4 max-w-xl text-cream/80">
          For speaking engagements, school visits, publishing, and translation inquiries.
        </p>
        <a
          href="mailto:abcedc@yahoo.com"
          class="mt-8 inline-block rounded-full bg-terracotta-dark px-8 py-3 font-semibold text-cream transition hover:bg-terracotta"
        >abcedc@yahoo.com</a>

        <!-- Social + shop links. Each sits in its own tilted paper chip so the
             row reads as three keepsakes pinned to the last page rather than a
             generic icon strip. -->
        <ul class="mt-10 flex items-center justify-center gap-4">
          {socials.map((s, i) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                title={s.label}
                class:list={[
                  'group flex h-12 w-12 items-center justify-center rounded-xl bg-cream/10 text-cream/80 ring-1 ring-cream/15 transition duration-300 hover:-translate-y-1 hover:bg-terracotta-dark hover:text-cream hover:ring-terracotta',
                  i % 2 === 0 ? '-rotate-3 hover:rotate-0' : 'rotate-3 hover:rotate-0',
                ]}
              >
                <Fragment set:html={s.icon} />
              </a>
            </li>
          ))}
        </ul>

        <p class="mt-12 text-sm text-cream/60">
          © {new Date().getFullYear()} Mary Ann Ordinario · ABC Educational Development Center Children's Books
        </p>
      </div>
    </footer>

    <style>
      /* Ambient footer life: stars twinkle, the whale drifts. One-property
         animations, absent entirely for reduced-motion users. */
      @media (prefers-reduced-motion: no-preference) {
        .footer-star {
          transform-origin: center;
          animation: footer-twinkle 4s ease-in-out infinite;
          animation-delay: var(--d, 0s);
        }
        @keyframes footer-twinkle {
          0%,
          100% {
            opacity: 0.6;
            transform: scale(0.9);
          }
          50% {
            opacity: 1;
            transform: scale(1.1);
          }
        }
        .footer-whale {
          animation: footer-bob 6s ease-in-out infinite;
        }
        @keyframes footer-bob {
          0%,
          100% {
            transform: translateY(0);
          }
          50% {
            transform: translateY(-6px);
          }
        }
      }
    </style>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menu?.classList.toggle('flex', open);
      });
      menu?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName === 'A') {
          menu.classList.add('hidden');
          menu.classList.remove('flex');
          btn?.setAttribute('aria-expanded', 'false');
          btn?.setAttribute('aria-label', 'Open menu');
        }
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
